{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HowLong",
  "version": "0.7.1",
  "identifier": "com.pietrodileo.howlong",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HowLong",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlEOTFFQTBFMDQ5MTQwRkIKUldUN1FKRUVEdXFSbmFHZCs2cndlazZXNGorRm1ldXlpNWtZWW42b1ZlRER3LzJNVEhISEIrZ2kK",
      "endpoints": [
        "https://github.com/pietrodileo/howlong/releases/latest/download/latest.json"
      ]
    }
  }
}
